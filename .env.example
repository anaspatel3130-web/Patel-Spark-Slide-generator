# Patel'Spark — Environment Configuration Template
# Copy this file to `.env` in production and customize values.

# 1. Security & JWT Authentication
SECRET_KEY=patelspark-super-secret-key-change-in-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 2. Default Master Administrator Account (Seeded on Startup)
ADMIN_EMAIL=admin@patelspark.internal
ADMIN_PASSWORD=PatelSpark2026!Admin

# 3. Database URL (Defaults to local SQLite; supports PostgreSQL in production)
# DATABASE_URL=sqlite:///./backend/patelspark.db

# 4. Optional Official Google Gemini API Key (Fact-Locked Narrative Polish)
# Leave blank to run 100% deterministic local Python agents with zero external API calls.
GEMINI_API_KEY=
